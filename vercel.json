{
  "buildCommand": "npx expo export --platform web",
  "outputDirectory": "dist",
  "framework": null,
  "functions": {
    "api/audio-proxy.ts": { "maxDuration": 60 },
    "api/catalog.ts": { "maxDuration": 15 },
    "api/chat.ts": { "maxDuration": 60 },
    "api/inner-ally-memory.ts": { "maxDuration": 30 },
    "api/agent.ts": { "maxDuration": 60 },
    "api/big5-leadership-insights.ts": { "maxDuration": 60 },
    "api/health.ts": { "maxDuration": 10 }
  },
  "rewrites": [
    { "source": "/((?!api/|_expo/|static/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/catalog",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=120, s-maxage=600, stale-while-revalidate=3600" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/api/((?!catalog|audio-proxy).*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, HEAD, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, Range" }
      ]
    },
    {
      "source": "/_expo/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
