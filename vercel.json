{
  "buildCommand": "mkdir -p public/interectives && cp interectives/gravity-v2.html interectives/pythagoras-v2.html interectives/wave-v2.html interectives/addition-subtraction.html public/interectives/ && npx expo export --platform web",
  "outputDirectory": "dist",
  "framework": null,
  "functions": {
    "api/chat.ts": { "maxDuration": 60 },
    "api/inner-ally-memory.ts": { "maxDuration": 30 },
    "api/agent.ts": { "maxDuration": 60 },
    "api/skills-coach.ts": { "maxDuration": 60 },
    "api/thinking-mode.ts": { "maxDuration": 60 },
    "api/big5-leadership-insights.ts": { "maxDuration": 60 },
    "api/health.ts": { "maxDuration": 10 }
  },
  "rewrites": [
    { "source": "/((?!api/|_expo/|static/|interectives/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, HEAD, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, Range" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
