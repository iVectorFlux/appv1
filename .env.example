# Copy to .env and fill in your Supabase values.
# Get URL and anon key from: Supabase Dashboard → Project Settings → API

# Client (Expo app) — safe to bundle
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-anon-public-key

# Where users land after email confirmation. Required for production.
# On web the app uses the current origin automatically; set this for native or if redirects point to localhost.
# Must match a URL added under Supabase Dashboard → Authentication → URL Configuration → Redirect URLs.
# EXPO_PUBLIC_APP_URL=https://appv1-erd1.vercel.app

# Native / dev: base URL of your deployed site so the app can call POST /api/chat (and other /api routes).
# Set in .env for local native builds and in EAS secrets as EXPO_PUBLIC_APP_URL — NOT the Groq key.
# EXPO_PUBLIC_APP_URL=https://your-project.vercel.app

# ── Groq (Vercel serverless only — /api/chat, /api/skills-coach) ────────────
# Vercel → Project → Settings → Environment Variables. Exact name: GROQ_API_KEY
# Do NOT use EXPO_PUBLIC_* (would bundle the key into the client).
# Redeploy after adding or changing the key.
# GROQ_API_KEY=gsk_...
# Optional model override (default: llama-3.3-70b-versatile in src/lib/groq-config.ts):
# GROQ_MODEL=llama-3.3-70b-versatile

# Server / backend only — NEVER use in the client app (contains DB password)
# Use for migrations, API routes, or server-side Postgres only.
# SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
